{
  "name": "opencode-flywheel",
  "displayName": "OpenCode Data Flywheel",
  "description": "Visualize OpenCode scan findings and label true/false positives",
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages",
    "Machine Learning",
    "Debuggers"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "opencodeFlywheel",
          "title": "OpenCode",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "opencodeFlywheel": [
        {
          "id": "opencodeFindings",
          "name": "Findings"
        }
      ]
    },
    "commands": [
      {
        "command": "opencode.refreshFindings",
        "title": "Refresh OpenCode Findings",
        "icon": "$(refresh)"
      },
      {
        "command": "opencode.selectSession",
        "title": "Select OpenCode Scan Session"
      },
      {
        "command": "opencode.openSummary",
        "title": "Open Scan Summary"
      },
      {
        "command": "opencode.openLogFile",
        "title": "Open Scan Log"
      },
      {
        "command": "opencode.openFindingDetail",
        "title": "Open Finding Detail"
      },
      {
        "command": "opencode.labelTruePositive",
        "title": "Mark as True Positive",
        "icon": "$(check)"
      },
      {
        "command": "opencode.labelFalsePositive",
        "title": "Mark as False Positive",
        "icon": "$(x)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "opencode.selectSession",
          "when": "view == opencodeFindings",
          "group": "navigation@1"
        },
        {
          "command": "opencode.refreshFindings",
          "when": "view == opencodeFindings",
          "group": "navigation@2"
        },
        {
          "command": "opencode.openLogFile",
          "when": "view == opencodeFindings",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "opencode.labelTruePositive",
          "when": "view == opencodeFindings && viewItem == finding",
          "group": "inline@1"
        },
        {
          "command": "opencode.labelFalsePositive",
          "when": "view == opencodeFindings && viewItem == finding",
          "group": "inline@2"
        }
      ]
    },
    "configuration": {
      "title": "OpenCode Flywheel",
      "properties": {
        "opencode.apiBaseUrl": {
          "type": "string",
          "default": "http://localhost:8080",
          "description": "Base URL of the OpenCode feedback API server"
        },
        "opencode.apiKey": {
          "type": "string",
          "default": "",
          "description": "API key for the OpenCode feedback API (optional)"
        },
        "opencode.autoLoadFindings": {
          "type": "boolean",
          "default": true,
          "description": "Automatically load findings when a scan completes"
        },
        "opencode.showLabeledFindings": {
          "type": "boolean",
          "default": false,
          "description": "Show findings that have already been labeled"
        },
        "opencode.activeDbPath": {
          "type": "string",
          "default": "",
          "description": "Path to the active findings.db file"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.0",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.80.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vscode/test-electron": "^2.3.0",
    "eslint": "^8.0.0",
    "glob": "^10.0.0",
    "mocha": "^10.0.0",
    "typescript": "^5.5.0"
  }
}
